# PostgreSQL connection used by FastAPI and Alembic
DATABASE_URL=postgresql+psycopg://jay:devpassword@localhost:5432/ai_support_lab

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# OpenAI configuration for AI-generated outreach drafts
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5-nano